#!/bin/sh
# Runs what CI runs for Go before anything leaves this machine. Enable with `make hooks`.
# Skip once with `git push --no-verify`.
#
# The browser E2E tests are not run here because they need Chrome and the npm packages;
# run them with `make e2e` (CI always runs them).

set -eu

cd "$(git rev-parse --show-toplevel)"

# Nothing to check when only deleting remote branches
deleting_only=1
while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$local_sha" = "0000000000000000000000000000000000000000" ] || deleting_only=0
done
[ "$deleting_only" -eq 0 ] || exit 0

echo "pre-push: gofmt"
make --no-print-directory fmt-check
echo "pre-push: go vet ./..."
go vet ./...
echo "pre-push: go build"
go build ./... && go build -o /dev/null ./cmd/agentlens
echo "pre-push: go test -race ./..."
go test -race ./...
